# Independent checkouts, not submodules. Each keeps its own remote, branches,
# and history; `npx robium-ai setup` clones them and `update` reviews them
# without touching your work.
/robium/
/robium-apps/

# Your own application library, created on demand by `robium-ai app new`.
/my-apps/

# Maintainers also keep the site checkout here so it resolves ../robium-apps.
/robium-website/

# Local backup/archive for assets and other materials that may be useful later.
/robium-backup/

# macOS Finder metadata.
.DS_Store
